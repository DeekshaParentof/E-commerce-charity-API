# --- Required ---
PORT=8080
MONGO_URL=mongodb://127.0.0.1:27017/charity-shop
JWT_SECRETE_KEY=replace-with-a-long-random-string
# Token lifetime (jsonwebtoken format: 1h, 1d, 7d ...)
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# --- Cloudinary (required only for admin image uploads: category/charity/product) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: order emails via Gmail (use an App Password) ---
EMAIL_USER=
EMAIL_PASS=
# If set, all emails go here instead of the customer / charity address (useful in dev)
TEST_RECIPIENT_EMAIL=

# --- Optional: order SMS via Twilio ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TEST_RECIPIENT_PHONE=

# --- Seed script (npm run seed) ---
SEED_ADMIN_EMAIL=admin@charityshop.org
SEED_ADMIN_PASSWORD=Admin@123
# Where seeded demo images are served from (default: /demo, i.e. frontend/public/demo)
DEMO_IMAGE_BASE_URL=
